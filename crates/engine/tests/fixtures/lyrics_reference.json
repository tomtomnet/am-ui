  {"name": "comment inside a paragraph", "ttml": "<tt xmlns=\"http://www.w3.org/ns/ttml\" xmlns:ttm=\"http://www.w3.org/ns/ttml#metadata\" xmlns:itunes=\"http://music.apple.com/lyric-ttml-internal\"><body><div><p begin=\"1\" end=\"2\">one<!-- note -->two <!-- other -->three</p></div></body></tt>", "lyrics": {"lines": [{"begin": 1.0, "end": 2.0, "text": "onetwo three", "words": [], "background": false, "agent": null}], "timing": "line", "language": null, "source": "lyrics"}},
